{
  "name": "AdminRequest",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "format": "email",
      "description": "Email of the user requesting admin access"
    },
    "user_name": {
      "type": "string",
      "description": "Full name of the requester"
    },
    "organization_name": {
      "type": "string",
      "description": "Organization name they want to admin"
    },
    "phone_number": {
      "type": "string",
      "description": "Contact phone number"
    },
    "reason": {
      "type": "string",
      "description": "Reason for requesting admin access"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Request status"
    },
    "access_code_hash": {
      "type": "string",
      "description": "Salted SHA-256 hash of the generated access code (plaintext never stored)"
    },
    "access_code_salt": {
      "type": "string",
      "description": "Per-request salt used when hashing the access code"
    },
    "code_used": {
      "type": "boolean",
      "default": false,
      "description": "Whether the code has been used"
    },
    "organization_id": {
      "type": "string",
      "description": "Organization ID assigned after approval"
    }
  },
  "required": [
    "user_email",
    "user_name",
    "organization_name",
    "phone_number"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin",
            "data.is_super_admin": true
          }
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin",
        "data.is_super_admin": true
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin",
        "data.is_super_admin": true
      }
    }
  }
}