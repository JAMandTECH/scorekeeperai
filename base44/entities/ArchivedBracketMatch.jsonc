{
  "name": "ArchivedBracketMatch",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "season_id": {
      "type": "string",
      "description": "Season this archived match belongs to"
    },
    "original_id": {
      "type": "string",
      "description": "Original BracketMatch record id"
    },
    "tournament_id": {
      "type": "string"
    },
    "archived_tournament_id": {
      "type": "string",
      "description": "Corresponding ArchivedTournament id"
    },
    "round_name": {
      "type": "string"
    },
    "match_number": {
      "type": "number"
    },
    "home_team_id": {
      "type": "string"
    },
    "away_team_id": {
      "type": "string"
    },
    "winner_team_id": {
      "type": "string"
    },
    "game_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "home_team_wins": {
      "type": "number",
      "default": 0
    },
    "away_team_wins": {
      "type": "number",
      "default": 0
    },
    "required_wins": {
      "type": "number",
      "default": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "ready",
        "in_progress",
        "completed"
      ],
      "default": "completed"
    },
    "next_match_id": {
      "type": "string"
    },
    "is_home_slot": {
      "type": "boolean"
    }
  },
  "required": [
    "organization_id",
    "season_id",
    "original_id",
    "tournament_id",
    "round_name",
    "match_number",
    "required_wins"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin",
            "is_super_admin": true
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.organization_id": "{{user.data.organization_id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin",
            "is_super_admin": true
          }
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "data.organization_id": "{{user.data.active_organization_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin",
            "is_super_admin": true
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.organization_id": "{{user.data.organization_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin",
            "is_super_admin": true
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.organization_id": "{{user.data.organization_id}}"
            }
          ]
        }
      ]
    }
  }
}