{
  "name": "ArchivedPlayerGameStats",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "season_id": {
      "type": "string",
      "description": "Season this archived stat belongs to"
    },
    "original_id": {
      "type": "string",
      "description": "Original PlayerGameStats record id"
    },
    "game_id": {
      "type": "string"
    },
    "archived_game_id": {
      "type": "string",
      "description": "Corresponding ArchivedGame id"
    },
    "player_id": {
      "type": "string"
    },
    "team_id": {
      "type": "string"
    },
    "quarter": {
      "type": "number"
    },
    "points": {
      "type": "number",
      "default": 0
    },
    "rebounds": {
      "type": "number",
      "default": 0
    },
    "assists": {
      "type": "number",
      "default": 0
    },
    "steals": {
      "type": "number",
      "default": 0
    },
    "blocks": {
      "type": "number",
      "default": 0
    },
    "fouls": {
      "type": "number",
      "default": 0
    },
    "three_pointers": {
      "type": "number",
      "default": 0
    },
    "field_goals_made": {
      "type": "number",
      "default": 0
    },
    "field_goals_attempted": {
      "type": "number",
      "default": 0
    },
    "free_throws_made": {
      "type": "number",
      "default": 0
    },
    "free_throws_attempted": {
      "type": "number",
      "default": 0
    },
    "aces": {
      "type": "number",
      "default": 0
    },
    "attacks": {
      "type": "number",
      "default": 0
    },
    "rally_errors": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "organization_id",
    "season_id",
    "original_id",
    "game_id",
    "player_id",
    "team_id",
    "quarter"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin",
            "is_super_admin": true
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.organization_id": "{{user.data.organization_id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin",
            "is_super_admin": true
          }
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "data.organization_id": "{{user.data.active_organization_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin",
            "is_super_admin": true
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.organization_id": "{{user.data.organization_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin",
            "is_super_admin": true
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.organization_id": "{{user.data.organization_id}}"
            }
          ]
        }
      ]
    }
  }
}