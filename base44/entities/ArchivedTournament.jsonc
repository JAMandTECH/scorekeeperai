{
  "name": "ArchivedTournament",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "season_id": {
      "type": "string",
      "description": "Season this archived tournament belongs to"
    },
    "original_id": {
      "type": "string",
      "description": "Original Tournament record id"
    },
    "name": {
      "type": "string"
    },
    "sport": {
      "type": "string",
      "enum": [
        "basketball",
        "volleyball"
      ]
    },
    "division": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date-time"
    },
    "end_date": {
      "type": "string",
      "format": "date-time"
    },
    "num_teams": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "setup",
        "seeding",
        "in_progress",
        "completed"
      ],
      "default": "completed"
    },
    "current_round": {
      "type": "string"
    },
    "best_of_settings": {
      "type": "object",
      "default": {}
    },
    "initial_teams": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "is_manual_bracket": {
      "type": "boolean",
      "default": false
    },
    "manual_matches": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "manual_connectors": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "manual_sections": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    }
  },
  "required": [
    "organization_id",
    "season_id",
    "original_id",
    "name",
    "sport"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin",
            "is_super_admin": true
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.organization_id": "{{user.data.organization_id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin",
            "is_super_admin": true
          }
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "data.organization_id": "{{user.data.active_organization_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin",
            "is_super_admin": true
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.organization_id": "{{user.data.organization_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin",
            "is_super_admin": true
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.organization_id": "{{user.data.organization_id}}"
            }
          ]
        }
      ]
    }
  }
}