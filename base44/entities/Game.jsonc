{
  "name": "Game",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "home_team_id": {
      "type": "string"
    },
    "away_team_id": {
      "type": "string"
    },
    "sport": {
      "type": "string",
      "enum": [
        "basketball",
        "volleyball"
      ]
    },
    "game_date": {
      "type": "string",
      "format": "date-time"
    },
    "court_number": {
      "type": "string"
    },
    "duration_hours": {
      "type": "number",
      "default": 1.5
    },
    "location": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "in_progress",
        "completed"
      ],
      "default": "scheduled"
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "game_type": {
      "type": "string",
      "enum": [
        "regular_season",
        "play_in",
        "playoffs",
        "quarter_finals",
        "semi_finals",
        "finals",
        "pre_season"
      ],
      "default": "regular_season"
    },
    "assigned_scorekeeper_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "overall_scorekeeper_email": {
      "type": "string"
    },
    "home_statistician_email": {
      "type": "string"
    },
    "away_statistician_email": {
      "type": "string"
    },
    "recurring_series_id": {
      "type": "string"
    },
    "week_number": {
      "type": "number"
    },
    "division": {
      "type": "string"
    },
    "home_score": {
      "type": "number",
      "default": 0
    },
    "away_score": {
      "type": "number",
      "default": 0
    },
    "quarter_scores": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "quarter": {
            "type": "number"
          },
          "home": {
            "type": "number"
          },
          "away": {
            "type": "number"
          }
        }
      },
      "default": []
    },
    "current_quarter": {
      "type": "number",
      "default": 1
    },
    "overtime_count": {
      "type": "number",
      "default": 0
    },
    "home_timeouts": {
      "type": "number",
      "default": 5
    },
    "away_timeouts": {
      "type": "number",
      "default": 5
    },
    "home_team_fouls": {
      "type": "number",
      "default": 0
    },
    "away_team_fouls": {
      "type": "number",
      "default": 0
    },
    "penalty_limit_per_quarter": {
      "type": "number",
      "default": 5
    },
    "player_foul_limit": {
      "type": "number",
      "default": 5
    },
    "stream_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "is_default": {
      "type": "boolean",
      "default": false
    },
    "defaulted_team_id": {
      "type": "string"
    },
    "winning_team_id": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "home_team_id",
    "away_team_id",
    "sport",
    "game_date"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin",
            "is_super_admin": true
          }
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "data.organization_id": "{{user.data.active_organization_id}}"
        },
        {
          "user_condition": {
            "is_scorekeeper": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin",
            "is_super_admin": true
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.organization_id": "{{user.data.organization_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "is_scorekeeper": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin",
            "is_super_admin": true
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.organization_id": "{{user.data.organization_id}}"
            }
          ]
        }
      ]
    }
  }
}