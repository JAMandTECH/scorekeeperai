{
  "name": "Organization",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Organization name"
    },
    "tournament_name": {
      "type": "string",
      "description": "Tournament or league name"
    },
    "contact_email": {
      "type": "string",
      "format": "email"
    },
    "contact_phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "subscription_tier": {
      "type": "string",
      "enum": [
        "free",
        "basic",
        "premium"
      ],
      "default": "free"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "trial",
        "active",
        "expired",
        "cancelled"
      ],
      "default": "trial"
    },
    "trial_end_date": {
      "type": "string",
      "format": "date-time"
    },
    "selected_sport": {
      "type": "string",
      "enum": [
        "basketball",
        "volleyball"
      ]
    },
    "paypal_subscription_id": {
      "type": "string"
    },
    "theme": {
      "type": "object",
      "properties": {
        "primary_color": {
          "type": "string",
          "default": "#3b82f6"
        },
        "secondary_color": {
          "type": "string",
          "default": "#f97316"
        },
        "accent_color": {
          "type": "string",
          "default": "#8b5cf6"
        }
      },
      "default": {
        "primary_color": "#3b82f6",
        "secondary_color": "#f97316",
        "accent_color": "#8b5cf6"
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "include_archived_in_leaders": {
          "type": "boolean",
          "default": false
        }
      },
      "default": {}
    },
    "season_pin": {
      "type": "string",
      "description": "Security PIN required to open a new season (prevents accidental creation)"
    },
    "standings_exclude_draws": {
      "type": "boolean",
      "default": false,
      "description": "When true, drawn games are excluded from the Win% calculation and the Draw column is hidden across all standings views."
    },
    "standings_exclude_defaults": {
      "type": "boolean",
      "default": false,
      "description": "When true, defaulted/forfeited games are excluded from the Win% calculation and the DEFAULT column is hidden across all standings views."
    }
  },
  "required": [
    "name",
    "contact_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin",
        "is_super_admin": true
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin",
            "is_super_admin": true
          }
        },
        {
          "id": "{{user.data.organization_id}}"
        },
        {
          "id": "{{user.data.active_organization_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin",
            "is_super_admin": true
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "id": "{{user.data.organization_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin",
        "is_super_admin": true
      }
    }
  }
}