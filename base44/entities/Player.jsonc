{
  "name": "Player",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Organization this player belongs to (org-scoped for RLS)"
    },
    "team_id": {
      "type": "string",
      "description": "Team this player belongs to"
    },
    "season_id": {
      "type": "string",
      "description": "Active season this player belongs to"
    },
    "jersey_number": {
      "type": "string"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "position": {
      "type": "string"
    },
    "contact_number": {
      "type": "string",
      "description": "Player contact number"
    },
    "height": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "total_points": {
      "type": "number",
      "default": 0
    },
    "total_rebounds": {
      "type": "number",
      "default": 0
    },
    "total_assists": {
      "type": "number",
      "default": 0
    },
    "games_played": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "team_id",
    "first_name",
    "last_name",
    "jersey_number"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin",
            "is_super_admin": true
          }
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "data.organization_id": "{{user.data.active_organization_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin",
            "is_super_admin": true
          }
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "data.organization_id": "{{user.data.active_organization_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin",
            "is_super_admin": true
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "$or": [
                {
                  "data.organization_id": "{{user.data.organization_id}}"
                },
                {
                  "data.organization_id": "{{user.data.active_organization_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin",
            "is_super_admin": true
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "$or": [
                {
                  "data.organization_id": "{{user.data.organization_id}}"
                },
                {
                  "data.organization_id": "{{user.data.active_organization_id}}"
                }
              ]
            }
          ]
        }
      ]
    }
  }
}