{
  "name": "PlayerFollow",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "follower_user_id": {
      "type": "string",
      "description": "User who follows"
    },
    "follower_profile_id": {
      "type": "string",
      "description": "Profile of the follower (if they have one)"
    },
    "followed_player_id": {
      "type": "string",
      "description": "Player being followed"
    },
    "followed_profile_id": {
      "type": "string",
      "description": "Profile being followed"
    }
  },
  "required": [
    "organization_id",
    "follower_user_id",
    "followed_player_id",
    "followed_profile_id"
  ],
  "rls": {
    "create": {
      "data.follower_user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.follower_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin",
            "is_super_admin": true
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.organization_id": "{{user.data.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.organization_id": "{{user.data.active_organization_id}}"
            }
          ]
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "data.organization_id": "{{user.data.active_organization_id}}"
        }
      ]
    },
    "update": {
      "data.follower_user_id": "{{user.id}}"
    },
    "delete": {
      "data.follower_user_id": "{{user.id}}"
    }
  }
}