{
  "name": "PlayerProfile",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Organization this profile belongs to"
    },
    "player_id": {
      "type": "string",
      "description": "Linked roster Player record (authoritative roster/stat source)"
    },
    "user_id": {
      "type": "string",
      "description": "App user who owns this profile"
    },
    "user_email": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "bio": {
      "type": "string",
      "description": "Player-written bio"
    },
    "photo_url": {
      "type": "string",
      "description": "Player-uploaded profile photo"
    },
    "cover_photo_url": {
      "type": "string"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "organization",
        "public"
      ],
      "default": "private",
      "description": "Who can view this profile"
    },
    "claim_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "approved"
    },
    "claim_date": {
      "type": "string",
      "format": "date-time"
    },
    "approved_date": {
      "type": "string",
      "format": "date-time"
    },
    "followers_count": {
      "type": "number",
      "default": 0
    },
    "posts_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "organization_id",
    "player_id",
    "user_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin",
            "is_super_admin": true
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.organization_id": "{{user.data.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.organization_id": "{{user.data.active_organization_id}}"
            }
          ]
        },
        {
          "data.visibility": "public"
        },
        {
          "$and": [
            {
              "data.visibility": "organization"
            },
            {
              "data.organization_id": "{{user.data.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "data.visibility": "organization"
            },
            {
              "data.organization_id": "{{user.data.active_organization_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin",
            "is_super_admin": true
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.organization_id": "{{user.data.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.organization_id": "{{user.data.active_organization_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin",
            "is_super_admin": true
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.organization_id": "{{user.data.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.organization_id": "{{user.data.active_organization_id}}"
            }
          ]
        }
      ]
    }
  }
}