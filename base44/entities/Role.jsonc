{
  "name": "Role",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "is_system_role": {
      "type": "boolean",
      "default": false
    },
    "permissions": {
      "type": "object",
      "properties": {
        "manage_organization": {
          "type": "boolean",
          "default": false
        },
        "manage_divisions": {
          "type": "boolean",
          "default": false
        },
        "manage_teams": {
          "type": "boolean",
          "default": false
        },
        "manage_players": {
          "type": "boolean",
          "default": false
        },
        "manage_games": {
          "type": "boolean",
          "default": false
        },
        "manage_scorekeepers": {
          "type": "boolean",
          "default": false
        },
        "live_scoring": {
          "type": "boolean",
          "default": false
        },
        "view_statistics": {
          "type": "boolean",
          "default": true
        },
        "manage_members": {
          "type": "boolean",
          "default": false
        },
        "manage_roles": {
          "type": "boolean",
          "default": false
        },
        "manage_social": {
          "type": "boolean",
          "default": false
        },
        "manage_tournaments": {
          "type": "boolean",
          "default": false
        },
        "data_backup": {
          "type": "boolean",
          "default": false
        }
      },
      "default": {
        "view_statistics": true
      }
    }
  },
  "required": [
    "organization_id",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin",
            "is_super_admin": true
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.organization_id": "{{user.data.organization_id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin",
            "is_super_admin": true
          }
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "data.organization_id": "{{user.data.active_organization_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin",
            "is_super_admin": true
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.organization_id": "{{user.data.organization_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin",
            "is_super_admin": true
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.organization_id": "{{user.data.organization_id}}"
            },
            {
              "data.is_system_role": false
            }
          ]
        }
      ]
    }
  }
}