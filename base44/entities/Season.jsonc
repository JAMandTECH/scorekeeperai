{
  "name": "Season",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Organization this season belongs to"
    },
    "name": {
      "type": "string",
      "description": "Season name (e.g. '2025 Winter League')"
    },
    "sport": {
      "type": "string",
      "enum": [
        "basketball",
        "volleyball"
      ],
      "description": "Sport for this season"
    },
    "division": {
      "type": "string",
      "description": "Division label if season is division-scoped"
    },
    "start_date": {
      "type": "string",
      "format": "date-time",
      "description": "Season start date"
    },
    "end_date": {
      "type": "string",
      "format": "date-time",
      "description": "Season end date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active",
      "description": "Season status"
    },
    "champion_team_id": {
      "type": "string",
      "description": "Champion team ID (set on archive)"
    },
    "champion_team_name": {
      "type": "string",
      "description": "Champion team name (set on archive)"
    },
    "final_standings": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": [],
      "description": "Snapshot of final division standings at archive time"
    },
    "top_leaders": {
      "type": "object",
      "description": "Snapshot of top statistical leaders at archive time",
      "default": {}
    },
    "notes": {
      "type": "string",
      "description": "Optional season notes"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the season was archived"
    },
    "archived_by": {
      "type": "string",
      "description": "Email of admin who archived the season"
    },
    "created_by": {
      "type": "string",
      "description": "Email of admin who created the season"
    }
  },
  "required": [
    "organization_id",
    "name",
    "sport",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin",
            "is_super_admin": true
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.organization_id": "{{user.data.organization_id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin",
            "is_super_admin": true
          }
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "data.organization_id": "{{user.data.active_organization_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin",
            "is_super_admin": true
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.organization_id": "{{user.data.organization_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin",
            "is_super_admin": true
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.organization_id": "{{user.data.organization_id}}"
            }
          ]
        }
      ]
    }
  }
}